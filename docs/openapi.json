{
  "openapi": "3.1.0",
  "info": {
    "title": "Sort API",
    "summary": "Sort numbers with quick sort and watch how it works.",
    "description": "A tiny demo API that sorts a list of numbers using the quick sort algorithm.\n\nUse `POST /sort` when you just want the answer, and `POST /sort/steps` when you want to see every partition along the way.",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/sort": {
      "post": {
        "tags": [
          "Sorting"
        ],
        "summary": "Sort numbers",
        "description": "Sort a list of numbers in ascending or descending order.\n\nPick the algorithm with `algorithm`: `quick` (default, O(n log n) on\naverage), `merge` (stable, always O(n log n)), or `heap` (O(n log n),\nconstant extra memory). An empty list is valid and returns an empty list.",
        "operationId": "sortNumbers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sort/steps": {
      "post": {
        "tags": [
          "Sorting"
        ],
        "summary": "Sort numbers and return every partition step",
        "description": "Sort a list of numbers and return each partition as it happened.\n\nEach step shows the `pivot` and how the remaining items were split into\n`before`, `equal`, and `after` groups. Steps are listed depth-first, so the\n\"before\" side is fully partitioned before the \"after\" side starts.",
        "operationId": "sortNumbersWithSteps",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortStepsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sort/stats": {
      "post": {
        "tags": [
          "Sorting"
        ],
        "summary": "Compare how long each algorithm takes",
        "description": "Sort the same list with every algorithm and report how long each took.\n\nHandy for showing that the right algorithm depends on the input. The\n`algorithm` field in the request is ignored here, since every algorithm runs.\nTimings are measured on the server and vary from run to run.",
        "operationId": "compareSortAlgorithms",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Algorithm": {
        "type": "string",
        "enum": [
          "quick",
          "merge",
          "heap"
        ],
        "title": "Algorithm"
      },
      "AlgorithmTiming": {
        "properties": {
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "The algorithm that was timed.",
            "examples": [
              "quick"
            ]
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "description": "How long the sort took, in milliseconds.",
            "examples": [
              0.042
            ]
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "elapsed_ms"
        ],
        "title": "AlgorithmTiming"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "Order"
      },
      "PartitionStep": {
        "properties": {
          "step": {
            "type": "integer",
            "title": "Step",
            "description": "1-based position of this partition in the run.",
            "examples": [
              1
            ]
          },
          "pivot": {
            "type": "number",
            "title": "Pivot",
            "description": "The value the list was split around (the middle item).",
            "examples": [
              9
            ]
          },
          "before": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Before",
            "description": "Items that sort before the pivot, still unsorted.",
            "examples": [
              [
                5,
                2,
                1,
                5,
                6
              ]
            ]
          },
          "equal": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Equal",
            "description": "Items equal to the pivot.",
            "examples": [
              [
                9
              ]
            ]
          },
          "after": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "After",
            "description": "Items that sort after the pivot, still unsorted.",
            "examples": [
              []
            ]
          }
        },
        "type": "object",
        "required": [
          "step",
          "pivot",
          "before",
          "equal",
          "after"
        ],
        "title": "PartitionStep"
      },
      "SortRequest": {
        "properties": {
          "numbers": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Numbers",
            "description": "The numbers to sort. Integers and decimals are both fine. Up to 1000 items.",
            "examples": [
              [
                5,
                2,
                9,
                1,
                5,
                6
              ]
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "Sort direction: `asc` (smallest first) or `desc` (largest first).",
            "default": "asc",
            "examples": [
              "asc"
            ]
          },
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "Which algorithm to use: `quick` (default), `merge` (stable), or `heap`. `/sort/steps` always uses `quick`.",
            "default": "quick",
            "examples": [
              "quick"
            ]
          }
        },
        "type": "object",
        "required": [
          "numbers"
        ],
        "title": "SortRequest"
      },
      "SortResponse": {
        "properties": {
          "result": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Result",
            "description": "The sorted numbers.",
            "examples": [
              [
                1,
                2,
                5,
                5,
                6,
                9
              ]
            ]
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "How many numbers were sorted.",
            "examples": [
              6
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "The direction that was used.",
            "examples": [
              "asc"
            ]
          },
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "The algorithm that was used.",
            "examples": [
              "quick"
            ]
          }
        },
        "type": "object",
        "required": [
          "result",
          "count",
          "order",
          "algorithm"
        ],
        "title": "SortResponse"
      },
      "SortStatsResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "How many numbers were sorted.",
            "examples": [
              6
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "The direction that was used.",
            "examples": [
              "asc"
            ]
          },
          "result": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Result",
            "description": "The sorted numbers (identical for every algorithm).",
            "examples": [
              [
                1,
                2,
                5,
                5,
                6,
                9
              ]
            ]
          },
          "timings": {
            "items": {
              "$ref": "#/components/schemas/AlgorithmTiming"
            },
            "type": "array",
            "title": "Timings",
            "description": "One timing per algorithm, fastest first."
          },
          "fastest": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "The algorithm that finished first on this input.",
            "examples": [
              "heap"
            ]
          }
        },
        "type": "object",
        "required": [
          "count",
          "order",
          "result",
          "timings",
          "fastest"
        ],
        "title": "SortStatsResponse"
      },
      "SortStepsResponse": {
        "properties": {
          "result": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Result",
            "description": "The sorted numbers.",
            "examples": [
              [
                1,
                2,
                5,
                5,
                6,
                9
              ]
            ]
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "How many numbers were sorted.",
            "examples": [
              6
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "The direction that was used.",
            "examples": [
              "asc"
            ]
          },
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "The algorithm that was used.",
            "examples": [
              "quick"
            ]
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/PartitionStep"
            },
            "type": "array",
            "title": "Steps",
            "description": "Every partition, in the order it happened."
          }
        },
        "type": "object",
        "required": [
          "result",
          "count",
          "order",
          "algorithm",
          "steps"
        ],
        "title": "SortStepsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Sorting",
      "description": "Sort a list of numbers."
    }
  ]
}
